{
  "name": "zest-ui",
  "version": "0.2.0",
  "description": "A modern, accessible UI component framework for building consistent interfaces — one package, ~75 components, zero raw HTML. Violet-forward, grey-neutral, built on Base UI primitives.",
  "keywords": [
    "react",
    "design-system",
    "ui",
    "components",
    "base-ui",
    "accessible",
    "zoho",
    "zest"
  ],
  "author": "karthik-selvan-8298",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karthik-selvan-8298/zest-ui.git"
  },
  "homepage": "https://github.com/karthik-selvan-8298/zest-ui#readme",
  "bugs": {
    "url": "https://github.com/karthik-selvan-8298/zest-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens/css/tokens.css",
    "./base.css": "./dist/base.css",
    "./fonts": {
      "types": "./dist/tokens/fonts.d.ts",
      "default": "./dist/tokens/fonts.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "default": "./dist/patterns/index.js"
    },
    "./*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/tokens/fonts.js"
  ],
  "publishConfig": {
    "registry": "https://npm.zoho-internal.example.com/"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-css.mjs src dist && node scripts/fix-esm.mjs dist",
    "prepare": "node .husky/install.mjs && npm run build",
    "prepublishOnly": "npm run check && npm run build && npm run check:package",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./tokens.css ./base.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "test-storybook --url http://localhost:6006",
    "test:visual:update": "test-storybook --url http://localhost:6006 -u",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,mdx,json,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/roboto": "^5.3.0",
    "lucide-react": "^1.53.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint-react/eslint-plugin": "^5.24.9",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@storybook/test-runner": "^0.26.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-image-snapshot": "^6.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-playwright": "^2.2.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "husky": "^9.1.7",
    "jest-image-snapshot": "^6.5.2",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.20.0",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@swc/core@1.16.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "jest": "~30.4.0",
    "@jest/core": "~30.4.0",
    "jest-runtime": "~30.4.0",
    "jest-runner": "~30.4.0",
    "jest-circus": "~30.4.0",
    "jest-environment-node": "~30.4.0",
    "uuid": "^11.1.1"
  }
}
