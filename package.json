{
  "name": "zest-ui",
  "version": "0.1.0",
  "description": "A modern, accessible UI component framework for building consistent interfaces \u2014 one package, ~65 components, zero raw HTML. Violet-forward, grey-neutral, built on Base UI primitives.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens/css/tokens.css",
    "./fonts": {
      "types": "./dist/tokens/fonts.d.ts",
      "default": "./dist/tokens/fonts.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "default": "./dist/patterns/index.js"
    },
    "./*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/tokens/fonts.js"
  ],
  "publishConfig": {
    "registry": "https://npm.zoho-internal.example.com/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs src dist && node scripts/fix-esm.mjs dist",
    "prepare": "npm run build",
    "test:visual": "test-storybook --url http://localhost:6006",
    "test:visual:update": "test-storybook --url http://localhost:6006 -u",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/roboto": "^5.2.5",
    "lucide-react": "^1.31.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-image-snapshot": "^6.4.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.5.8",
    "jest-image-snapshot": "^6.5.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^10.5.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
